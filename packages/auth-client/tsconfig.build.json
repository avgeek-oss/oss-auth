{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    // Browser code: no Node types, so a node:* import or a Node global
    // fails the build.
    "types": [],
    "customConditions": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
