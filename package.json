{
  "name": "oss-auth",
  "private": true,
  "description": "Shared sign-in, provisioning and access control for Avgeek OSS apps.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avgeek-oss/oss-auth.git"
  },
  "homepage": "https://github.com/avgeek-oss/oss-auth#readme",
  "bugs": {
    "url": "https://github.com/avgeek-oss/oss-auth/issues"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:example": "pnpm build && pnpm --filter @avgeek-oss/example-hono-vite dev",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size",
    "size": "pnpm --filter @avgeek-oss/auth-client size"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "^8.23.1",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
